# rsagent systemd 单元。deb 包和 install.sh 会安装它；`rsagent service install` 会生成等价配置。
# 手工安装：复制到 /etc/systemd/system/rsagent.service，然后
#   systemctl daemon-reload && systemctl enable --now rsagent
[Unit]
Description=RemoteSerial Agent
After=network-online.target
Wants=network-online.target

[Service]
# /etc/default/rsagent 可设 RSAGENT_AUTH_KEY / RSAGENT_TAGS，首次启动自动入网，入网后应删掉
EnvironmentFile=-/etc/default/rsagent
ExecStart=/usr/bin/rsagent run --data-dir /var/lib/rsagent
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
