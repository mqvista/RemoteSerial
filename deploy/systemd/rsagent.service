# 手工安装用的 systemd 单元模板；`rsagent service install` 会自动生成等价配置。
# 复制到 /etc/systemd/system/rsagent.service，按需修改路径，然后：
#   systemctl daemon-reload && systemctl enable --now rsagent
[Unit]
Description=RemoteSerial Agent
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/rsagent/rsagent run --data-dir /var/lib/rsagent
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
